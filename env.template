# Arf server-side environment.
#
# Copy this file to `.env` (which is gitignored) and fill in your values. These
# are read by `arf-serve` at startup (see `load_dotenv` in src/main.rs). They
# are SERVER-SIDE ONLY — none of these values are ever sent to the browser.

# HuggingFace API token. OPTIONAL. When set, it is attached as a Bearer header on
# the server's upstream calls to the HuggingFace models API (powers /hf/search,
# raising rate limits and surfacing gated repos). It is NEVER returned in any HTTP
# response and NEVER reaches the browser. Leave blank to search anonymously.
HF_TOKEN=

# Postgres connection string for OPTIONAL chat persistence (build with the
# `postgres` feature). Server-side only; never exposed to the browser. When unset
# (or unreachable) the server persists nothing and the web client falls back to
# localStorage.
# DATABASE_URL=postgres://user:password@localhost:5432/arf
